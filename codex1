#!/data/data/com.termux/files/usr/bin/bash
# Codex1 — Termux device care toolkit
# Developer: MrCodex1Tz | Facebook: MrCodex1Tz
set -u

VERSION="1.0.0"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; DIM='\033[2m'; RESET='\033[0m'

say() { printf "%b\n" "$*"; }
info() { say "${CYAN}[*]${RESET} $*"; }
ok() { say "${GREEN}[+]${RESET} $*"; }
warn() { say "${YELLOW}[!]${RESET} $*"; }
fail() { say "${RED}[x]${RESET} $*"; }
need_cmd() { command -v "$1" >/dev/null 2>&1; }

banner() {
  say "${CYAN}"
  cat <<'EOF'
 ______     ______     _____     ______     __  __
/\  ___\   /\  __ \   /\  __-.  /\  ___\   /\_\_\_\
\ \ \____  \ \ \/\ \  \ \ \/\ \ \ \  _*\   \/*/\_/__
 \ \_____\  \ \_____\  \ \_*__-  \ \___*_\   /\_\/\_\
  \/____/   \/____*/   \/_*__/   \/__*_*/   \/*/\/_/
EOF
  say "${RESET}"
  say "${DIM}Codex1 v${VERSION} · Termux device care toolkit${RESET}"
  say "${DIM}by MrCodex1Tz · Facebook: MrCodex1Tz${RESET}"
}

usage() {
  cat <<'EOF'

Usage: codex1 <command> [options]

Commands:
  help                         Show this help
  version                      Show version and developer
  status                       Check Termux tools and Android access
  screen info                  Show current screen size and density
  screen scale <percent>       Preview/apply a density scale (80-140)
  screen reset                 Reset Android display density
  network check                Check internet, DNS, latency and Wi-Fi info
  network repair               Open safe Android network settings
  update check                 Show Android version and security patch
  update settings              Open official Android system update settings
  security audit               Check ADB, app sources, screen lock and updates
  scan files [path]            Scan accessible files with ClamAV (report only)
  scan quarantine [path]       Move detected files to a reversible quarantine
  backup create [file]         Back up accessible phone files to a compressed archive
  backup list <file>           List files inside a Codex1 backup
  backup restore <file>        Restore a backup after confirmation
  caller country <number>      Detect country from a phone number prefix
  voice effects                Show offline audio effects
  voice apply <effect> <in> <out>  Apply an effect to an audio file
  camera capture <file>        Capture a photo with Termux:API
  camera watermark <in> <out> Add a Codex1 watermark to an image
  camera zoom <in> <out> <%>   Digital zoom/crop an image (100-800)
  setup                        Install recommended Termux packages
  adb devices                  List authorized Android devices over ADB
  adb info                     Read basic device information (read-only)
  flash guide                  Show the official firmware maintenance workflow
  flash verify <file>          Print file size and SHA-256 before flashing

Examples:
  codex1 status
  codex1 screen info
  codex1 screen scale 110
  codex1 network check
  codex1 update check
  codex1 security audit
  codex1 scan files ~/storage/downloads
  codex1 backup create ~/codex1-backup.tar.gz
  codex1 caller country +255712345678
  codex1 voice apply robot input.wav output.wav
  codex1 camera capture ~/storage/pictures/codex1.jpg
  codex1 camera watermark input.jpg output.jpg
  codex1 camera zoom input.jpg output.jpg 300
  codex1 flash verify ~/storage/downloads/firmware.zip

Notes:
  - Screen density changes usually require ADB, root, or Shizuku permissions.
  - Use only on a phone you own or are authorized to repair.
  - Codex1 does not bypass PIN, FRP, carrier locks, accounts, or security.
  - Official Android updates are installed through Android Settings, not forced by Termux.
  - Malware scanning is limited to files Termux can access; it cannot replace Android Play Protect.
EOF
}

screen_info() {
  if ! need_cmd wm; then
    fail "The Android 'wm' command is not available in this Termux session."
    say "Install/use ADB, root, or Shizuku permissions, then try again."
    return 1
  fi
  say "${CYAN}Screen information${RESET}"
  wm size 2>&1 || true
  wm density 2>&1 || true
  if need_cmd settings; then
    say "Font scale: $(settings get system font_scale 2>/dev/null || echo 'unavailable')"
  fi
}

current_density() {
  local raw density
  raw="$(wm density 2>/dev/null || true)"
  density="$(printf '%s\n' "$raw" | sed -nE 's/.*Override density: ([0-9]+).*/\1/p' | head -n1)"
  [ -n "$density" ] || density="$(printf '%s\n' "$raw" | sed -nE 's/.*Physical density: ([0-9]+).*/\1/p' | head -n1)"
  printf '%s' "${density:-0}"
}

screen_scale() {
  local percent="$1" base target
  case "$percent" in ''|*[!0-9]*) fail "Scale must be a whole number from 80 to 140."; return 1 ;; esac
  if [ "$percent" -lt 80 ] || [ "$percent" -gt 140 ]; then fail "Scale must be between 80 and 140 percent."; return 1; fi
  need_cmd wm || { fail "Android 'wm' is unavailable. Use ADB/root/Shizuku permissions."; return 1; }
  base="$(current_density)"
  [ "$base" -gt 0 ] || { fail "Could not read the current density."; return 1; }
  target=$((base * 100 / percent))
  warn "This changes Android display density to ${target} dpi (${percent}% content scale)."
  say "To undo: codex1 screen reset"
  wm density "$target" 2>&1 && ok "Display density updated." || { fail "Permission denied. Try ADB, root, or Shizuku."; return 1; }
}

screen_reset() {
  need_cmd wm || { fail "Android 'wm' is unavailable."; return 1; }
  wm density reset 2>&1 && ok "Display density reset to the device default." || { fail "Permission denied. Try ADB, root, or Shizuku."; return 1; }
}

network_check() {
  say "${CYAN}Network diagnostics${RESET}"
  if need_cmd ping; then
    ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1 && ok "Internet reachability: OK (1.1.1.1)" || warn "Internet reachability: failed"
  else warn "ping is missing; run: pkg install inetutils"; fi
  if need_cmd getent; then
    getent hosts example.com >/dev/null 2>&1 && ok "DNS resolution: OK (example.com)" || warn "DNS resolution: failed"
  else warn "getent is missing; run: pkg install dnsutils"; fi
  if need_cmd curl; then
    local timing; timing="$(curl -L -o /dev/null -sS --max-time 6 -w '%{http_code} %{time_total}s' https://example.com 2>/dev/null || true)"
    [ -n "$timing" ] && ok "HTTPS request: $timing" || warn "HTTPS request: failed"
  fi
  if need_cmd termux-wifi-connectioninfo; then
    say "Wi-Fi info:"; termux-wifi-connectioninfo 2>/dev/null | sed -n '1,14p'
  else warn "Wi-Fi info unavailable; install Termux:API and run: pkg install termux-api"; fi
}

network_repair() {
  warn "Codex1 will not silently change APN, proxy, or private DNS settings."
  if need_cmd termux-wifi-enable; then
    termux-wifi-enable true >/dev/null 2>&1 || true
    ok "Wi-Fi enable request sent."
  fi
  if need_cmd termux-open-settings; then
    termux-open-settings android.settings.WIRELESS_SETTINGS >/dev/null 2>&1 || termux-open-settings >/dev/null 2>&1 || true
    ok "Opened Android network settings. Try airplane mode, forget/reconnect Wi-Fi, then restart the router."
  else
    say "Open Android Settings → Network & internet, then try airplane mode and reconnect Wi-Fi."
  fi
}

update_check() {
  say "${CYAN}Android update information${RESET}"
  if need_cmd getprop; then
    printf '%-24s %s\n' "Model" "$(getprop ro.product.manufacturer) $(getprop ro.product.model)"
    printf '%-24s %s\n' "Android version" "$(getprop ro.build.version.release)"
    printf '%-24s %s\n' "Security patch" "$(getprop ro.build.version.security_patch)"
    printf '%-24s %s\n' "Build" "$(getprop ro.build.display.id)"
  else
    warn "Android getprop is unavailable in this Termux session."
  fi
  say "Use Android Settings → System → Software update to check the newest official build."
}

update_settings() {
  if need_cmd termux-open-settings; then
    termux-open-settings android.settings.SYSTEM_UPDATE_SETTINGS >/dev/null 2>&1 || termux-open-settings >/dev/null 2>&1 || true
    ok "Opened Android's official system update settings."
  else
    say "Open Settings → System → Software update, then download and install the official update."
  fi
  warn "Codex1 does not force-flash a firmware image: the correct package depends on your exact model, region, bootloader and manufacturer."
}

security_audit() {
  say "${CYAN}Security audit${RESET}"
  if need_cmd adb; then
    local adb_state; adb_state="$(adb devices 2>/dev/null | awk 'NR==2 {print $2}')"
    [ "$adb_state" = "device" ] && warn "USB debugging has an authorized ADB connection; disable it when not needed." || ok "No authorized USB-debugging device detected."
  else
    warn "ADB is not installed; USB debugging status could not be checked."
  fi
  if need_cmd getprop; then
    local patch; patch="$(getprop ro.build.version.security_patch)"
    printf 'Android security patch: %s\n' "${patch:-unknown}"
    [ -n "$patch" ] && ok "Check this date against Settings → Security & privacy." || warn "Security patch date unavailable."
  fi
  if need_cmd termux-open-settings; then
    say "Review manually: Play Protect, unknown app sources, screen lock, Google account devices, and Privacy dashboard."
    termux-open-settings android.settings.SECURITY_SETTINGS >/dev/null 2>&1 || true
  else
    say "Open Android Settings → Security & privacy and review Play Protect and unknown app sources."
  fi
  warn "Termux cannot guarantee that nobody can hack a phone. Keep Android updated, use a strong lock, 2FA, Play Protect, and avoid unknown APKs."
}

scan_files() {
  local mode="report" path="${1:-$HOME/storage/downloads}" quarantine="$HOME/.codex1/quarantine"
  [ "${1:-}" = "--quarantine" ] && { mode="quarantine"; path="${2:-$HOME/storage/downloads}"; }
  [ -d "$path" ] || { fail "Directory not found: $path. Run termux-setup-storage first if needed."; return 1; }
  need_cmd clamscan || { fail "ClamAV is not installed. Run: pkg install clamav"; return 1; }
  if [ "$mode" = "quarantine" ]; then
    mkdir -p "$quarantine"
    warn "Detected files will be moved (not deleted) to: $quarantine"
    clamscan --infected --recursive --move="$quarantine" "$path"
  else
    info "Scanning accessible files (report only): $path"
    clamscan --infected --recursive "$path"
    say "No files were changed. Review any FOUND lines before taking action."
  fi
}

backup_create() {
  local output="${1:-$HOME/codex1-backup-$(date +%Y%m%d-%H%M%S).tar.gz}" shared="$HOME/storage/shared"
  [ -d "$shared" ] || { fail "Shared storage is not available. Run: termux-setup-storage"; return 1; }
  local dirs=() dir
  for dir in DCIM Download Downloads Pictures Movies Music Documents; do
    [ -e "$shared/$dir" ] && dirs+=("$dir")
  done
  [ "${#dirs[@]}" -gt 0 ] || { fail "No supported phone folders were found in shared storage."; return 1; }
  mkdir -p "$(dirname "$output")"
  info "Creating a backup of accessible folders: ${dirs[*]}"
  tar -czf "$output" -C "$shared" --ignore-failed-read "${dirs[@]}" && {
    ok "Backup created: $output"
    say "Size: $(du -h "$output" | awk '{print $1}')"
    say "This backup does not include protected app data, passwords, or banking data."
  }
}

backup_list() {
  local archive="$1"
  [ -f "$archive" ] || { fail "Backup file not found: $archive"; return 1; }
  tar -tzf "$archive" | sed -n '1,120p'
}

backup_restore() {
  local archive="$1" target="${2:-$HOME/storage/shared}"
  [ -f "$archive" ] || { fail "Backup file not found: $archive"; return 1; }
  [ -d "$target" ] || { fail "Restore target not found: $target"; return 1; }
  if tar -tzf "$archive" | grep -E '(^/|(^|/)\.\.(\/|$))' >/dev/null 2>&1; then
    fail "Backup contains an unsafe path and was not restored."; return 1
  fi
  warn "Files in the backup may overwrite files with the same names in: $target"
  printf 'Type RESTORE to continue: '
  read -r confirmation
  [ "$confirmation" = "RESTORE" ] || { warn "Restore cancelled."; return 0; }
  tar -xzf "$archive" -C "$target" && ok "Backup restored to: $target"
}

caller_country() {
  local number="${1:-}" normalized
  normalized="$(printf '%s' "$number" | tr -cd '0-9+')"
  [ -n "$normalized" ] || { fail "Usage: codex1 caller country +255712345678"; return 1; }
  case "$normalized" in
    +255*|00255*) say "Country: Tanzania (+255)" ;;
    +254*|00254*) say "Country: Kenya (+254)" ;;
    +256*|00256*) say "Country: Uganda (+256)" ;;
    +250*|00250*) say "Country: Rwanda (+250)" ;;
    +257*|00257*) say "Country: Burundi (+257)" ;;
    +1*) say "Country: United States/Canada (+1) — exact country may need a full numbering database" ;;
    +44*|0044*) say "Country: United Kingdom (+44)" ;;
    +91*|0091*) say "Country: India (+91)" ;;
    +27*|0027*) say "Country: South Africa (+27)" ;;
    +971*|00971*) say "Country: United Arab Emirates (+971)" ;;
    *) warn "Country code not in the offline list. Use the complete number with +country-code."; return 1 ;;
  esac
  warn "A country code is not proof of caller identity. Never share OTPs, passwords, or personal data with unknown callers."
}

voice_effects() {
  say "Offline audio effects (not live phone-call voice spoofing):"
  say "  deep      Lower pitch"
  say "  high      Raise pitch"
  say "  robot     Mechanical/robotic effect"
  say "Example: codex1 voice apply robot input.wav output.wav"
  say "Install the audio engine with: pkg install ffmpeg"
}

voice_apply() {
  local effect="$1" input="$2" output="$3" filter
  [ -f "$input" ] || { fail "Input audio file not found: $input"; return 1; }
  need_cmd ffmpeg || { fail "FFmpeg is not installed. Run: pkg install ffmpeg"; return 1; }
  case "$effect" in
    deep) filter="asetrate=44100*0.78,aresample=44100,atempo=1.282" ;;
    high) filter="asetrate=44100*1.22,aresample=44100,atempo=0.819" ;;
    robot) filter="asetrate=44100*0.82,aresample=44100,atempo=1.22,chorus=0.6:0.9:50:0.4:0.25:2" ;;
    *) fail "Unknown effect: $effect. Use: deep, high, or robot"; return 1 ;;
  esac
  ffmpeg -hide_banner -loglevel error -y -i "$input" -af "$filter" "$output" && ok "Created offline voice-effect file: $output"
}

image_tool() {
  if need_cmd magick; then printf '%s' "magick"; elif need_cmd convert; then printf '%s' "convert"; else return 1; fi
}

camera_capture() {
  local output="$1"
  need_cmd termux-camera-photo || { fail "Termux:API is required. Install the Termux:API app and run: pkg install termux-api"; return 1; }
  mkdir -p "$(dirname "$output")"
  termux-camera-photo "$output" && ok "Photo captured: $output"
}

camera_watermark() {
  local input="$1" output="$2" tool
  [ -f "$input" ] || { fail "Input image not found: $input"; return 1; }
  tool="$(image_tool)" || { fail "ImageMagick is not installed. Run: pkg install imagemagick"; return 1; }
  "$tool" "$input" -gravity southeast -fill 'rgba(255,255,255,0.78)' -stroke 'rgba(0,0,0,0.45)' -strokewidth 2 -pointsize 42 -annotate +28+25 'Codex1' "$output" && ok "Codex1 watermark added: $output"
}

camera_zoom() {
  local input="$1" output="$2" percent="$3" crop tool
  [ -f "$input" ] || { fail "Input image not found: $input"; return 1; }
  case "$percent" in ''|*[!0-9]*) fail "Zoom must be a whole number from 100 to 800."; return 1 ;; esac
  [ "$percent" -ge 100 ] && [ "$percent" -le 800 ] || { fail "Zoom must be between 100 and 800 percent."; return 1; }
  tool="$(image_tool)" || { fail "ImageMagick is not installed. Run: pkg install imagemagick"; return 1; }
  crop=$((10000 / percent))
  "$tool" "$input" -gravity center -crop "${crop}%" +repage "$output" && ok "Digital zoom ${percent}% created: $output"
  warn "This is digital zoom: it crops pixels and cannot create detail that the camera did not capture."
}

setup() {
  need_cmd pkg || { fail "This command is for Termux. Install Termux from F-Droid or GitHub releases."; return 1; }
  info "Installing recommended packages: curl, inetutils, dnsutils, android-tools, clamav, ffmpeg, imagemagick, termux-api"
  pkg update -y && pkg install -y curl inetutils dnsutils android-tools clamav ffmpeg imagemagick termux-api && ok "Termux packages installed."
}

adb_devices() {
  need_cmd adb || { fail "ADB is not installed. Run: codex1 setup"; return 1; }
  adb start-server >/dev/null 2>&1 || true
  adb devices
}

adb_info() {
  need_cmd adb || { fail "ADB is not installed. Run: codex1 setup"; return 1; }
  local device; device="$(adb devices | awk 'NR==2 && $2=="device" {print $1}')"
  [ -n "$device" ] || { warn "No authorized ADB device found. Enable USB debugging on your own device."; return 1; }
  say "${CYAN}Read-only device information${RESET}"
  for prop in ro.product.manufacturer ro.product.model ro.build.version.release ro.build.version.security_patch; do
    printf '%-24s %s\n' "$prop" "$(adb -s "$device" shell getprop "$prop" 2>/dev/null | tr -d '\r')"
  done
}

flash_guide() {
  cat <<'EOF'

Official firmware maintenance workflow

1. Confirm the exact model, region/CSC, bootloader state, and battery level.
2. Back up photos, contacts, chats, and any 2FA recovery codes.
3. Download firmware only from the phone manufacturer or an authorized service source.
4. Verify the SHA-256 checksum with: codex1 flash verify <file>
5. Read the manufacturer's service instructions for that exact model.
6. Use the manufacturer's official recovery/flashing utility. Do not disconnect during a flash.
7. Allow the device to boot fully, then restore your backup.

Codex1 intentionally does not bypass screen locks, FRP, carrier locks, Google/Samsung accounts,
bootloader authorization, or other access controls. If a phone is locked, use the owner's account
recovery or an authorized service center.
EOF
}

flash_verify() {
  local file="$1"
  [ -f "$file" ] || { fail "File not found: $file"; return 1; }
  say "${CYAN}Firmware file verification${RESET}"
  printf 'File: %s\n' "$file"
  printf 'Size: '; du -h "$file" | awk '{print $1}'
  if need_cmd sha256sum; then sha256sum "$file"; elif need_cmd shasum; then shasum -a 256 "$file"; else warn "Install coreutils to calculate SHA-256."; fi
  warn "Compare this hash with the manufacturer's published checksum before using the file."
}

status() {
  say "${CYAN}Codex1 status${RESET}"
  printf '%-18s %s\n' "Termux" "${PREFIX:-unknown}"
  printf '%-18s %s\n' "Android wm" "$(need_cmd wm && echo available || echo unavailable)"
  printf '%-18s %s\n' "ADB" "$(need_cmd adb && echo installed || echo not-installed)"
  printf '%-18s %s\n' "curl" "$(need_cmd curl && echo installed || echo not-installed)"
  printf '%-18s %s\n' "Wi-Fi API" "$(need_cmd termux-wifi-connectioninfo && echo available || echo optional)"
}

main() {
  case "${1:-help}" in
    help|-h|--help) banner; usage ;;
    version|-v|--version) say "Codex1 ${VERSION} · by MrCodex1Tz · Facebook: MrCodex1Tz" ;;
    status) status ;;
    screen) case "${2:-info}" in info) screen_info ;; scale) [ "$#" -ge 3 ] && screen_scale "$3" || { fail "Usage: codex1 screen scale <80-140>"; exit 1; } ;; reset) screen_reset ;; *) usage; exit 1 ;; esac ;;
    network) case "${2:-check}" in check) network_check ;; repair) network_repair ;; *) usage; exit 1 ;; esac ;;
    update) case "${2:-check}" in check) update_check ;; settings) update_settings ;; *) usage; exit 1 ;; esac ;;
    security) case "${2:-audit}" in audit) security_audit ;; *) usage; exit 1 ;; esac ;;
    scan) case "${2:-files}" in files) scan_files "${3:-$HOME/storage/downloads}" ;; quarantine) scan_files --quarantine "${3:-$HOME/storage/downloads}" ;; *) usage; exit 1 ;; esac ;;
    backup) case "${2:-create}" in create) backup_create "${3:-$HOME/codex1-backup-$(date +%Y%m%d-%H%M%S).tar.gz}" ;; list) [ "$#" -ge 3 ] && backup_list "$3" || { fail "Usage: codex1 backup list <file>"; exit 1; } ;; restore) [ "$#" -ge 3 ] && backup_restore "$3" "${4:-$HOME/storage/shared}" || { fail "Usage: codex1 backup restore <file> [target]"; exit 1; } ;; *) usage; exit 1 ;; esac ;;
    caller) [ "${2:-}" = "country" ] && [ "$#" -ge 3 ] && caller_country "$3" || { fail "Usage: codex1 caller country <number>"; exit 1; } ;;
    voice) case "${2:-effects}" in effects) voice_effects ;; apply) [ "$#" -ge 5 ] && voice_apply "$3" "$4" "$5" || { fail "Usage: codex1 voice apply <effect> <input> <output>"; exit 1; } ;; *) usage; exit 1 ;; esac ;;
    camera) case "${2:-capture}" in capture) [ "$#" -ge 3 ] && camera_capture "$3" || { fail "Usage: codex1 camera capture <file>"; exit 1; } ;; watermark) [ "$#" -ge 4 ] && camera_watermark "$3" "$4" || { fail "Usage: codex1 camera watermark <input> <output>"; exit 1; } ;; zoom) [ "$#" -ge 5 ] && camera_zoom "$3" "$4" "$5" || { fail "Usage: codex1 camera zoom <input> <output> <100-800>"; exit 1; } ;; *) usage; exit 1 ;; esac ;;
    setup) setup ;;
    adb) case "${2:-devices}" in devices) adb_devices ;; info) adb_info ;; *) usage; exit 1 ;; esac ;;
    flash) case "${2:-guide}" in guide) flash_guide ;; verify) [ "$#" -ge 3 ] && flash_verify "$3" || { fail "Usage: codex1 flash verify <file>"; exit 1; } ;; *) usage; exit 1 ;; esac ;;
    *) fail "Unknown command: $1"; usage; exit 1 ;;
  esac
}
main "$@"
